  "1532": "متابعة اللعب؟",
  "1600": "<LABEL>ليتا:</LABEL>\n\"يسعدني لقاؤك،\"",
  "1601": "المعلم أوتينكو، والسيد <NAME>!",
  "1700": "<LABEL>ليتا:</LABEL>\n\"دعني أوضح لك الأمر.",
  "1701": "اضغط الزر <WEIGHT>\b</WEIGHT> للتأكيد.\"",
  "1800": "<LABEL>ليتا الخجولة:</LABEL>\n\"سيد <NAME>!\"",
  "1801": "...",
  "1900": "الدروع:\nالفارس الأبيض الفضي:",
  "2000": "يرجى سداد القرض المستحق.",
  "2001": "إذا تأخرت في سداد القرض،\nستتراكم الفوائد المظلمة!",
  "2100": "لقد أنقذتني مجدداً،\nيا <NAME>!\"",
  "2201": "حتى بعد انتهاء فرط الإحماء،\nراقب حرارة البندقية بعناية.",
  "2210": "أنا أعتمد عليك،\nيا فتى الشمس <NAME>!!\"",
  "2212": "<OTENKO=AMAZE><LABEL>المعلم أوتينكو:</LABEL>\n\"أتهرب وتتراجع؟",
  "2213": "لن ترقى لمكانة والدك أبداً\nإن واصلت التصرف هكذا!\"",
  "2215": "في مكان ليس ببعيد\nعن هنا والآن...",
  "2216": "...نهاية العالم\nتدنو وتقترب...",
  "2217": "الموتى الأحياء يظهرون،\nكاسرين دورة الحياة\nوالموت الطبيعية.",
  "2218": "تطور الكائنات يتوقف...\nوواحداً تلو الآخر،\nمصيرها الانقراض.",
  "2221": "<LABEL>؟؟؟:</LABEL>\n\"هذه هي مدينة الموت،\n<WEIGHT>[إستراكان]</WEIGHT>.",
  "2222": "منذ أقدم العصور،",
  "2223": "حُكمت هذه المدينة المظلمة\nمن قِبَل جنس يُدعى\n<WEIGHT>[الخالدين]</WEIGHT>.",
  "2224": "لكن الآن، وأخيراً...\nالشمس تشرق من جديد...\"",
  "2226": "<LABEL>؟؟؟:</LABEL>\nلقد جئت أخيراً!",
  "2227": "وريث بندقية الشمس،\n<WEIGHT>[غان ديل سول]</WEIGHT>...",
  "2228": "<WEIGHT>[صائد مصاصي الدماء]</WEIGHT>\nالجديد!",
  "2229": "اسمي <WEIGHT>[أوتينكو]</WEIGHT>،\nرسول الشمس.",
  "2230": "معاً سنعيد النور\nإلى هذا العالم!",
  "2231": "في القلعة أمامنا يقبع\n<WEIGHT>[سيد مصاصي الدماء]</WEIGHT>.",
  "2232": "انطلق يا فتى الشمس!\"",
  "2234": "حصلت على\n<WEIGHT>[بطاقة الأبله]</WEIGHT>!",
  "2236": "<OTENKO=SERIOUS><LABEL>المعلم أوتينكو:</LABEL>\n\"حسناً!",
  "2237": "الآن ضع التابوت\nفي منتصف مصفوفة\n<WEIGHT>[بايل درايفر]</WEIGHT>!\"",
  "2239": "<LABEL>المعلم أوتينكو:</LABEL>\n\"هنا مكان مناسب. انظر؛",
  "2240": "هذه هي مصفوفة\n<WEIGHT>[بايل درايفر]</WEIGHT>!",
  "2241": "<PROC=1>تاييووووووو!!\"",
  "2243": "<OTENKO=SERIOUS><LABEL>المعلم أوتينكو:</LABEL>\n\"سيد مصاصي الدماء...",
  "2244": "زعيم جنس مصاصي الدماء\nالخالدين.",
  "2245": "الجراح التي أصابه بها\nوالدك لم تلتئم بعد.",
  "2246": "هذه هي فرصتنا الوحيدة!",
  "2247": "حتى أنت قادر على النصر...\nإن تحركت الآن.",
  "2248": "استمع يا فتى الشمس.\nاجلبه هو و<WEIGHT>[تابوته]</WEIGHT>\nإلى هنا.",
  "2249": "سنطهره بنور الشمس\nوهذه المصفوفة!",
  "2250": "<OTENKO=NORMAL>تحتاج إلى ضوء الشمس\nلتشغيل مصفوفة بايل درايفر.",
  "2251": "<PROC=1>أترى المؤشر ذا علامة\nالشمس في الزاوية؟",
  "2252": "إنه يعرض كمية أشعة الشمس\nالساقطة على\n<WEIGHT>[مستشعر الشمس]</WEIGHT>.",
  "2253": "ويُسمى\n<WEIGHT>[مقياس الشمس]</WEIGHT>.\"",
  "2254": "<OTENKO=SERIOUS>لا يمكنك تشغيل المصفوفة\nإن كان مستوى الشمس صفراً.\"",
  "2256": "<OTENKO=SERIOUS><LABEL>المعلم أوتينكو:</LABEL>\n\"نحن جاهزون!",
  "2257": "اضغط زر <WEIGHT>\b</WEIGHT> فوق\nالرمز المشع لتشغيل\nمصفوفة بايل درايفر!",
  "2258": "هل الشمس ساطعة؟\"",
  "2260": "<OTENKO=ANGRY><LABEL>المعلم أوتينكو:</LABEL>\n\"انتظر!\n<PROC=0>",
  "2300": "<LABEL>المعلم أوتينكو:</LABEL>\n\"<NAME>،\n...هل هذا صحيح!؟",
  "2301": "لا أصدق هذا!\"",
  "2400": "ولكن لكسر الختم ومتابعة\nالسير شمالاً...",
  "2500": "اضغط باستمرار على الزر\nأمام محطة الشمس.",
  "2600": "إن عجزت عن الخروج\nمن هذه الغرفة،",
  "2701": "<LABEL>المعلم أوتينكو:</LABEL>\n\"يبدو أنه باب يُفتح\nبواسطة رافعة!\"",
  "2801": "ممر ميغاروك الجنوبي",
  "2803": "<LABEL>المعلم أوتينكو:</LABEL>\n\"انتبه يا <NAME>!\"",
  "2901": "<LABEL>ساباتا:</LABEL>\n\"همف!",
  "2902": "سأستغل قواك إذن!\"",
  "3000": "<LABEL>المعلم أوتينكو:</LABEL>\n\"احذر يا <NAME>!",
  "3001": "الأرضية زلقة جداً!\"",
  "3200": "حسناً...\nالآن جاء دورك.",
  "3201": "<PROC=1>تعال إلي!\"",
  "3400": "إرادة المجرة واضحة!",
  "3401": "إنها ترفض طمع البشر...",
  "3800": "<LABEL>الفتاة الحزينة:</LABEL>\n\"لا أستطيع تركك تذهب...\"",
  "3900": "بقي حارس واحد فقط.",
  "3902": "هيا بنا يا <NAME>!",
  "4000": "تعمل بندقية الشمس\nبطاقة الشمس، لكنها\nتسخن إن شحنت أكثر.",
  "4001": "احرص على أخذ\nفترات راحة منتظمة.",
  "4002": "وضعية جهاز اللعبة\nتؤثر على كمية الضوء\nالتي تلتقطها.",
  "4003": "احرص على تجربة\nزوايا مختلفة!",
  "4004": "يمكنك إيجاد أشعة\nالشمس في كل مكان،\nسواء بالظل أو النور.",
  "4005": "استغل أشعة الشمس\nبحكمة في المعارك.",
  "4006": "في الظلام، احذر من\nحركة الموتى الأحياء.",
  "4007": "حتى وإن كان الوقت\nنهاراً، راقب دائماً\nمؤشر الشمس!",
  "4008": "طاقة الشمس هي أملك\nالوحيد للبقاء حياً.",
  "4009": "استخدم الجدران للاختباء\nمن عيون الخالدين.",
  "4010": "اطرق على الجدران\nلجذب انتباه الحراس.",
