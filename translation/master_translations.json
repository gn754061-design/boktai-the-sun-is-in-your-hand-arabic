  "123": "مستشعر الشمس معطل!",
  "482": "<LABEL>المعلم أوتينكو:</LABEL>\n\"اليوم هو الأحد،\nيوم الشمس العظيم!",
  "483": "<OTENKO=WINK>مع هذا الطقس الجميل،\nسيكون يوماً مثالياً\nلمغامرة بوكتاي!\"",
  "485": "<LABEL>المعلم أوتينكو:</LABEL>\n\"اليوم هو الأحد،\nيوم الشمس العظيم!",
  "486": "<OTENKO=WINK>لا تبق في روتين واحد!\nجرب اللعب في\nأوقات مختلفة.\"",
  "515": "<LABEL>المعلم أوتينكو:</LABEL>\n<PROC=1>\"فلتكن الشمس معك!\nودائماً...\"",
  "533": "<LABEL>المعلم أوتينكو:</LABEL>\n<PROC=1>\"فلتكن الشمس معك!\"",
  "541": "<LABEL>المعلم أوتينكو:</LABEL>\n\"ليست هذه مرتي الأولى\nعلى هذه الأرض.",
  "542": "يتم استدعائي دائماً\nكلما تعرض نظامنا\nالشمسي للخطر.\"",
  "544": "<LABEL>المعلم أوتينكو:</LABEL>\n\"منذ زمن بعيد...\nلم أكن كائناً مميزاً.",
  "545": "كان الجميع يحملون\nالشمس في قلوبهم.",
  "546": "حتى في هذا الكوكب\nالبعيد، لم تغب الشمس\nعن وجدانهم أبداً.",
  "547": "لكن الآن، امتلأت\nقلوب البشر بالظلام.",
  "548": "قوى الظلام الغاشمة...",
  "549": "هذه هي الفرصة التي\nطالما انتظروها.\"",
  "551": "<LABEL>المعلم أوتينكو:</LABEL>\n\"واجبي هو حماية\nهذا النظام الشمسي",
  "552": "وحماية كل من نشأ\nهنا بفضل خيرات\nوعطاء الشمس.\"",
  "554": "<LABEL>المعلم أوتينكو:</LABEL>\n\"مع ذلك، ينحصر دوري\nفي الإرشاد فقط.",
  "555": "أستطيع إيصال إرادة\nالشمس...\nلكنني لا أستطيع القتال.\"",
  "558": "<LABEL>المعلم أوتينكو:</LABEL>\n\"ذلك الهجوم المباغت\nمن الخالدين...",
  "559": "تم استدعائي هذه المرة\nبعد أن هزم الكونت\nوالدك الشجاع.",
  "560": "كانوا يلقبونه بأعظم\nصياد مصاصي دماء\nعرفه التاريخ.",
  "561": "صديقي العزيز، <WEIGHT>[رينغو]</WEIGHT>.\"",
  "563": "<LABEL>المعلم أوتينكو:</LABEL>\n\"والآن، أنت أملنا\nالوحيد المتبقي.",
  "564": "أنا أعتمد عليك يا فتى\nالشمس، <NAME>!\"",
  "566": "<LABEL>المعلم أوتينكو:</LABEL>\n<PROC=1>\"فلتكن الشمس معك!\"",
  "568": "<LABEL>المعلم أوتينكو:</LABEL>\n\"يا <NAME>،\nفي الشمال الغربي تقبع",
  "569": "شجرة الشمس المباركة.\"",
  "600": "<LABEL>المعلم أوتينكو:</LABEL>\n\"أشعر بالظلام...\nاحذر يا فتى الشمس!\"",
  "601": "<LABEL>المعلم أوتينكو:</LABEL>\n\"يمكنك إعادة شحن طاقتك\nتحت ضوء الشمس!\"",
  "632": "لقد كسرنا الفخ!\nيبدو الأمر سهلاً للغاية يا <NAME>.",
  "702": "<LABEL>المعلم أوتينكو:</LABEL>\n\"...\nبخصوص والدك...\"",
  "771": "<LABEL>المعلم أوتينكو:</LABEL>\n<PROC=1>\"فلتكن الشمس معك!\"",
  "773": "شجرة الشمس تناديك...\n...............على ما أعتقد.",
  "775": "شجرة الشمس تناديك...\n....لقد نضجت الثمار!",
